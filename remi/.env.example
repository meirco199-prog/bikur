# --- חובה ---
# טוקן הבוט מ-BotFather בטלגרם
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# מפתח API של Anthropic (מ-https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# --- מומלץ ---
# מזהה המשתמש שלך בטלגרם (מספר). רק המשתמש הזה יוכל לדבר עם הבוט.
# אפשר לגלות את המזהה עם הבוט @userinfobot בטלגרם. השאר ריק כדי לאפשר לכולם.
ALLOWED_USER_ID=

# שם העוזר (איך שהוא מציג את עצמו)
ASSISTANT_NAME=רמי

# אזור זמן
TIMEZONE=Asia/Jerusalem
