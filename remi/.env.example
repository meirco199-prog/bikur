# --- חובה ---
# טוקן הבוט מ-BotFather בטלגרם
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# מפתח API של Anthropic (מ-https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# --- מומלץ ---
# מזהה המשתמש שלך בטלגרם (מספר). רק המשתמש הזה יוכל לדבר עם הבוט.
# אפשר לגלות את המזהה עם הבוט @userinfobot בטלגרם. השאר ריק כדי לאפשר לכולם.
ALLOWED_USER_ID=

# --- וואטסאפ (רק אם מריצים את whatsapp_bot.py — ראה README-whatsapp.md) ---
# טוקן גישה מ-Meta for Developers (WhatsApp > API Setup)
WHATSAPP_TOKEN=
# ה-Phone number ID מאותו מסך (לא מספר הטלפון עצמו!)
WHATSAPP_PHONE_NUMBER_ID=
# מחרוזת סודית שאתה ממציא, ומזינים אותה גם בהגדרת ה-Webhook ב-Meta
WHATSAPP_VERIFY_TOKEN=remi-verify
# המספר שלך בפורמט בינלאומי בלי + (למשל 972501234567) — רק הוא יוכל לדבר עם הבוט
ALLOWED_WA_NUMBER=

# שם העוזר (איך שהוא מציג את עצמו)
ASSISTANT_NAME=רמי

# אזור זמן
TIMEZONE=Asia/Jerusalem
